# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me
META_GRAPH_API_VERSION=v27.0
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me

# Worker recovery and retry policy
WORKER_REPLY_MODE=echo
WORKER_MAX_SEND_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_STALE_SEND_SECONDS=300

# PostgreSQL
DATABASE_URL=postgresql+psycopg://clinicflow:clinicflow@127.0.0.1:5433/clinicflow

# Free local development model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MAX_OUTPUT_TOKENS=256

# Optional local voice transcription (install with uv sync --extra voice)
VOICE_TRANSCRIBER=off
WHISPER_MODEL=small

# Staff-only development API. Leave empty to keep the routes disabled.
STAFF_DEV_TOKEN=
STAFF_DEV_TENANT_SLUG=noor-clinic-demo
HANDOFF_PAUSE_SECONDS=0

# Limits reset at midnight for each clinic. Zero disables the corresponding limit.
CUSTOMER_DAILY_MESSAGE_LIMIT=40
TENANT_DAILY_TOKEN_LIMIT=120000

# Optional exception reporting (install with uv sync --extra observability)
SENTRY_DSN=
